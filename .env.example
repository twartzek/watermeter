# Copy this file to watermeter/.env and adjust the paths for your machine.
# setupscript.sh generates this automatically on a real Pi install (with
# paths rooted at /home/admin/...) -- this example is for local dev.

db=./data/watermeter.db
images=./data/images
log=./data/log
venv=./backend/.venv
mainpath=.
settingspath=./data/settings.json
frontend=./frontend/dist
model_digits=./backend/models/digits/best.pt
model_needles=./backend/models/totalandneedles/best.pt
